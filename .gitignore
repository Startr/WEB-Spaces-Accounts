# Hidden-artifact allowlist: deny dotfiles and dotfolders everywhere in the
# repo unless they are intentionally shared and explicitly included below.
.*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.editorconfig
!.*.example
!/.env.leave

# Project-specific (sites managed by site builder; data managed at runtime)
sites
site_backup
data/

# Python build & runtime junk
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
MANIFEST
build/
dist/
venv/
env/
ENV/

# Django runtime
db.sqlite3
db.sqlite3-journal
local_settings.py
*.log

# Test / coverage
htmlcov/
coverage.xml

# Translations
*.mo
